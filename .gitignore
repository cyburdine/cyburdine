.DS_Store

# Salvaged scratch files that live outside the served document root.
# The site is served from site/ — a top-level assets/ is no longer part of the
# build, so keep it out of version control rather than re-adding 3 MB of it.
/assets/

# Scratch from the brainstorming tool (a server pid + log), not source.
.superpowers/

# Camera originals for write-ups. 22 MB and climbing, and none of it is served —
# site/ is the document root, so only the encoded webp in
# site/assets/images/articles/ ever ships. Keep the raws out of history for the
# same reason /assets/ is out.
photos/
